# Copy this file to .env and fill in your values

# PostgreSQL connection string
DATABASE_URL=postgresql://iblitz:iblitz123@localhost:5432/iblitz

# JWT signing secret — change this before deploying to production
SECRET_KEY=iblitz-dev-secret-key-change-in-production

# JWT expiry in minutes (default: 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
